#!/usr/bin/env python3
"""One entry point for every check in this repo.

The tiers cost wildly different amounts — the unit suite is free and instant, the evals
spend real tokens and minutes — so they can't all just run. But four separate commands
(`pytest`, `pytest tests_smoke`, `RUN_SKILL_EVALS=1 pytest tests_eval`,
`scripts/capture_fixtures.py`) is four things to remember for a repo whose whole point is
reducing what you must remember. One command, explicit flags, and `--help` that states
the cost of each tier.

    ./check                 # lint + unit tests (free, ~1s) — the default before every commit
    ./check --smoke         # + run every read-only entry point on this machine (~1 min)
    ./check --evals         # + LLM skill evals (spends tokens, several minutes)
    ./check --all           # everything above
    ./check --capture       # refresh tests/fixtures/ from this machine's real tool output

    ./check --smoke -k ssh  # extra args after the flags go straight to pytest

Exit code is non-zero if any selected tier fails, so this drops into CI or a git hook.
"""

from __future__ import annotations

import subprocess
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parent

TIERS = {
    "lint": ("ruff check .", ["ruff", "check", "."], "free, instant"),
    "unit": ("pytest", [sys.executable, "-m", "pytest", "-q"], "free, ~1s"),
    "smoke": (
        "pytest tests_smoke",
        [sys.executable, "-m", "pytest", "tests_smoke", "-q"],
        "free, ~1 min, macOS only",
    ),
    "evals": (
        "RUN_SKILL_EVALS=1 pytest tests_eval",
        [sys.executable, "-m", "pytest", "tests_eval", "-q"],
        "SPENDS TOKENS, several minutes",
    ),
}


def run(name: str, extra: list[str]) -> bool:
    label, argv, cost = TIERS[name]
    print(f"\n\033[1m── {name}\033[0m  ({label} — {cost})", flush=True)
    env = None
    if name == "evals":
        import os

        env = {**os.environ, "RUN_SKILL_EVALS": "1"}
    proc = subprocess.run(argv + extra, cwd=ROOT, env=env)
    ok = proc.returncode == 0
    print(f"   {'✅ pass' if ok else '❌ FAIL'}", flush=True)
    return ok


def main(argv: list[str]) -> int:
    if "-h" in argv or "--help" in argv:
        print(__doc__.strip())
        return 0

    if "--capture" in argv:
        return subprocess.run(
            [sys.executable, str(ROOT / "scripts" / "capture_fixtures.py")]
            + [a for a in argv if a != "--capture"],
            cwd=ROOT,
        ).returncode

    selected = ["lint", "unit"]
    if "--all" in argv:
        selected += ["smoke", "evals"]
    else:
        if "--smoke" in argv:
            selected.append("smoke")
        if "--evals" in argv:
            selected.append("evals")

    extra = [a for a in argv if not a.startswith("--") or a in ("--lf", "--ff")]
    results = {name: run(name, extra) for name in selected}

    print("\n\033[1m── summary\033[0m")
    for name, ok in results.items():
        print(f"   {'✅' if ok else '❌'} {name}")
    failed = [n for n, ok in results.items() if not ok]
    if failed:
        print(f"\n{len(failed)} tier(s) failed: {', '.join(failed)}")
        return 1
    skipped = [t for t in ("smoke", "evals") if t not in selected]
    if skipped:
        print(f"   (not run: {', '.join(skipped)} — see --help)")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
